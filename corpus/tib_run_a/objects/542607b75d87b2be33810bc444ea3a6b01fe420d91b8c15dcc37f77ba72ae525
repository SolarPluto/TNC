rl\":\"https://img.apmcdn.org/0a7552f8f92f81770ec9ae8e363a9fc6576dbd97/thumbnail/7fe224-20130520-oklahoma-tornado2.jpg\",\"width\":300,\"height\":226}]},\"uncropped\":{\"slug\":\"uncropped\",\"instances\":[{\"url\":\"https://img.apmcdn.org/0a7552f8f92f81770ec9ae8e363a9fc6576dbd97/uncropped/79e847-20130520-oklahoma-tornado2.jpg\",\"width\":400,\"height\":312},{\"url\":\"https://img.apmcdn.org/0a7552f8f92f81770ec9ae8e363a9fc6576dbd97/uncropped/912afc-20130520-oklahoma-tornado2.jpg\",\"width\":600,\"height\":469},{\"url\":\"https://img.apmcdn.org/0a7552f8f92f81770ec9ae8e363a9fc6576dbd97/uncropped/9f302c-20130520-oklahoma-tornado2.jpg\",\"width\":1000,\"height\":781}]},\"widescreen\":{\"slug\":\"widescreen\",\"instances\":[{\"url\":\"https://img.apmcdn.org/0a7552f8f92f81770ec9ae8e363a9fc6576dbd97/widescreen/bb64be-20130520-oklahoma-tornado2.jpg\",\"width\":400,\"height\":225},{\"url\":\"https://img.apmcdn.org/0a7552f8f92f81770ec9ae8e363a9fc6576dbd97/widescreen/202d7e-20130520-oklahoma-tornado2.jpg\",\"width\":600,\"height\":337},{\"url\":\"https://img.apmcdn.org/0a7552f8f92f81770ec9ae8e363a9fc6576dbd97/widescreen/29c1fc-20130520-oklahoma-tornado2.jpg\",\"width\":1000,\"height\":562}]}},\"short_caption\":\"Oklahoma tornado\",\"preferred_aspect_ratio_slug\":\"uncropped\"}},{\"type\":\"paragraph\",\"content\":[{\"text\":\"By TIM TALLEY\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"\\nAssociated Press\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n\\tMOORE, Okla. (AP) -- A monstrous tornado at least a half-mile wide roared through the Oklahoma City suburbs Monday, flattening entire neighborhoods and destroying an elementary school with a direct blow as children and teachers huddled against winds up to 200 mph. At least 51 people were killed, including at least 20 children, and officials said the death toll was expected to rise.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\" \\n\\tThe storm laid waste to scores of buildings in Moore, a community of 41,000 people about 10 miles south of the city. Block after block lay in ruins. Homes were crushed into piles of broken wood. Cars and trucks were left crumpled on the roadside.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \",\"type\":\"text\"},{\"text\":\"• \",\"type\":\"text\",\"marks\":[{\"type\":\"strong\"}]},{\"text\":\"Photos: Tornado hits Moore, Okla.\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"http://minnesota.publicradio.org/display/web/2013/05/20/weather/photos-oklahoma-tornado\",\"title\":null}},{\"type\":\"strong\"}]},{\"type\":\"hard_break\",\"marks\":[{\"type\":\"strong\"}]},{\"text\":\"\\n• \",\"type\":\"text\",\"marks\":[{\"type\":\"strong\"}]},{\"text\":\"Interactive: Monstrous tornado strikes\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"http://minnesota.publicradio.org/features/2013/05/oklatornado/oklatornado.shtml\",\"title\":null}},{\"type\":\"strong\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\tThe National Weather Service issued an initial finding that the tornado was an EF-4 on the enhanced Fujita scale, the second most-powerful type of twister.\\n \",\"type\":\"text\"}]},{\"type\":\"apm_image\",\"attrs\":{\"id\":\"da0965d76f0398cd5da8c6fc2e70ea5849965662\",\"url\":\"https://img.publicradio.org/images/20130520-oklahoma-tornado3.jpg\",\"type\":\"apmImage\",\"float\":\"right\",\"width\":\"half\",\"credit\":\"AP Photo/Sue Ogrocki\",\"credit_url\":\"\",\"long_caption\":\"A child calls to his father after being pulled from the rubble of the Tower Plaza Elementary School following a tornado in Moore, Okla., Monday, May 20, 2013. A tornado as much as a mile wide with winds up to 200 mph roared through the Oklahoma City suburbs Monday, flattening entire neighborhoods, setting buildings on fire and landing a direct blow on an elementary school.\",\"aspect_ratios\":{\"normal\":{\"slug\":\"normal\",\"instances\":[{\"url\":\"https://img.apmcdn.org/da0965d76f0398cd5da8c6fc2e70ea5849965662/normal/bae5b6-20130520-oklahoma-tornado3.jpg\",\"width\":400,\"height\":301},{\"url\":\"https://img.apmcdn.org/da0965d76f0398cd5da8c6fc2e70ea5849965662/normal/162d9a-20130520-oklahoma-tornado3.jpg\",\"width\":600,\"height\":451},{\"url\":\"https://img.apmcdn.org/da0965d76f0398cd5da8c6fc2e70ea5849965662/normal/221bce-20130520-oklahoma-tornado3.jpg\",\"width\":1000,\"height\":752}]},\"square\":{\"slug\":\"square\",\"instances\":[{\"url\":\"https://img.apmcdn.org/da0965d76f0398cd5da8c6fc2e70ea5849965662/square/e8acd8-20130520-oklahoma-tornado3.jpg\",\"width\":400,\"height\":400},{\"url\":\"https://img.apmcdn.org/da0965d76f0398cd5da8c6fc2e70ea5849965662/square/1b2082-20130520-oklahoma-tornado3.jpg\",\"width\":600,\"height\":600},{\"url\":\"https://img.apmcdn.org/da0965d76f0398cd5da8c6fc2e70ea5849965662/square/032e1a-20130520-oklahoma-tornado3.jpg\",\"width\":1000,\"height\":1000}]},\"portrait\":{\"slug\":\"portrait\",\"instances\":[{\"url\":\"https://img.apmcdn.org/da0965d76f0398cd5da8c6fc2e70ea5849965662/portrait/0b06d1-20130520-oklahoma-tornado3.jpg\",\"width\":400,\"height\":500},{\"url\":\"https://img.apmcdn.org/da0965d76f0398cd5da8c6fc2e70ea5849965662/portrait/f68225-20130520-oklahoma-tornado3.jpg\",\"width\":600,\"height\":750},{\"url\":\"https://img.apmcdn.org/da0965d76f0398cd5da8c6fc2e70ea5849965662/portrait/8ef9f9-20130520-oklahoma-tornado3.jpg\",\"width\":1000,\"height\":1250}]},\"thumbnail\":{\"slug\":\"thumbnail\",\"instances\":[{\"url\":\"https://img.apmcdn.org/da0965d76f0398cd5da8c6fc2e70ea5849965662/thumbnail/cb815c-20130520-oklahoma-tornado3.jpg\",\"width\":120,\"height\":90},{\"url\":\"https://img.apmcdn.org/da0965d76f0398cd5da8c6fc2e70ea5849965662/thumbnail/b5db0c-20130520-oklahoma-tornado3.jpg\",\"width\":300,\"height\":226}]},\"uncropped\":{\"slug\":\"uncropped\",\"instances\":[{\"url\":\"https://img.apmcdn.org/da0965d76f0398cd5da8c6fc2e70ea5849965662/uncropped/b0d300-20130520-oklahoma-tornado3.jpg\",\"width\":400,\"height\":542},{\"url\":\"https://img.apmcdn.org/da0965d76f0398cd5da8c6fc2e70ea5849965662/uncropped/bf560e-20130520-oklahoma-tornado3.jpg\",\"width\":600,\"height\":813},{\"url\":\"https://img.apmcdn.org/da0965d76f0398cd5da8c6fc2e70ea5849965662/uncropped/66d363-20130520-oklahoma-tornado3.jpg\",\"width\":1000,\"height\":1356}]},\"widescreen\":{\"slug\":\"widescreen\",\"instances\":[{\"url\":\"https://img.apmcdn.org/da0965d76f0398cd5da8c6fc2e70ea5849965662/widescreen/b396a7-20130520-oklahoma-tornado3.jpg\",\"width\":400,\"height\":225},{\"url\":\"https://img.apmcdn.org/da0965d76f0398cd5da8c6fc2e70ea5849965662/widescreen/39d9cd-20130520-oklahoma-tornado3.jpg\",\"width\":600,\"height\":337},{\"url\":\"https://img.apmcdn.org/da0965d76f0398cd5da8c6fc2e70ea5849965662/widescreen/d35230-20130520-oklahoma-tornado3.jpg\",\"width\":1000,\"height\":562}]}},\"short_caption\":\"Oklahoma tornado\",\"preferred_aspect_ratio_slug\":\"uncropped\"}},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n\\tMore than 120 people were being treated at hospitals, including about 50 children. And search-and-rescue efforts were to continue throughout the night.\\n \",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n\\tTiffany Thronesberry said she heard from her mother, Barbara Jarrell, shortly after the tornado.\\n \",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n\\t\\\"I got a phone call from her screaming, `Help! Help! I can't breathe. My house is on top of me!\\\"' Thronesberry said.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tThronesberry hurried to her mother's house, where first responders had already pulled her out. Her mother was hospitalized for treatment of cuts and bruises.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tRescuers launched a desperate rescue effort at the school, pulling children from heaps of debris and carrying them to a triage center.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tOklahoma Gov. Mary Fallin deployed 80 National Guard members to assist with rescue operations and activated extra highway patrol officers.\",\"type\":\"text\"}]},{\"type\":\"apm_image\",\"attrs\":{\"id\":\"5cedd197b6d11e9ab1ce4d5751c6299ecc51e3db\",\"url\":\"https://img.publicradio.org/images/20130520-tornado4.jpg\",\"type\":\"apmImage\",\"float\":\"right\",\"width\":\"half\",\"credit\":\"AP Photo/Sue Ogrocki\",\"credit_url\":\"\",\"long_caption\":\"A child is carried from the rubble of the Plaza Towers Elementary School following a tornado in Moore, Okla., Monday, May 20, 2013. A tornado as much as a mile wide with winds up to 200 mph roared through the Oklahoma City suburbs Monday, flattening entire neighborhoods, setting buildings on fire and landing a direct blow on an elementary school.\",\"aspect_ratios\":{\"normal\":{\"slug\":\"normal\",\"instances\":[{\"url\":\"https://img.apmcdn.org/5cedd197b6d11e9ab1ce4d5751c6299ecc51e3db/normal/8b15d9-20130520-tornado4.jpg\",\"width\":400,\"height\":301},{\"url\":\"https://img.apmcdn.org/5cedd197b6d11e9ab1ce4d5751c6299ecc51e3db/normal/7015f0-20130520-tornado4.jpg\",\"width\":600,\"height\":451},{\"url\":\"https://img.apmcdn.org/5cedd197b6d11e9ab1ce4d5751c6299ecc51e3db/normal/e53b8e-20130520-tornado4.jpg\",\"width\":1000,\"height\":752}]},\"square\":{\"slug\":\"square\",\"instances\":[{\"url\":\"https://img.apmcdn.org/5cedd197b6d11e9ab1ce4d5751c6299ecc51e3db/square/dd6494-20130520-tornado4.jpg\",\"width\":400,\"height\":400},{\"url\":\"https://img.apmcdn.org/5cedd197b6d11e9ab1ce4d5751c6299ecc51e3db/square/835f91-20130520-tornado4.jpg\",\"width\":600,\"height\":600},{\"url\":\"https://img.apmcdn.org/5cedd197b6d11e9ab1ce4d5751c6299ecc51e3db/square/2a6f08-20130520-tornado4.jpg\",\"width\":1000,\"height\":1000}]},\"portrait\":{\"slug\":\"portrait\",\"instances\":[{\"url\":\"https://img.apmcdn.org/5cedd197b6d11e9ab1ce4d5751c6299ecc51e3db/portrait/28caaf-20130520-tornado4.jpg\",\"width\":400,\"height\":500},{\"url\":\"https://img.apmcdn.org/5cedd197b6d11e9ab1ce4d5751c6299ecc51e3db/portrait/ad4418-20130520-tornado4.jpg\",\"width\":600,\"height\":750},{\"url\":\"https://img.apmcdn.org/5cedd197b6d11e9ab1ce4d5751c6299ecc51e3db/portrait/23d540-20130520-tornado4.jpg\",\"width\":1000,\"height\":1250}]},\"thumbnail\":{\"slug\":\"thumbnail\",\"instances\":[{\"url\":\"https://img.apmcdn.org/5cedd197b6d11e9ab1ce4d5751c6299ecc51e3db/thumbnail/42a65f-20130520-tornado4.jpg\",\"width\":120,\"height\":90},{\"url\":\"https://img.apmcdn.org/5cedd197b6d11e9ab1ce4d5751c6299ecc51e3db/thumbnail/a75fbb-20130520-tornado4.jpg\",\"width\":300,\"height\":226}]},\"uncropped\":{\"slug\":\"uncropped\",\"instances\":[{\"url\":\"https://img.apmcdn.org/5cedd197b6d11e9ab1ce4d5751c6299ecc51e3db/uncropped/311999-20130520-tornado4.jpg\",\"width\":400,\"height\":292},{\"url\":\"https://img.apmcdn.org/5cedd197b6d11e9ab1ce4d5751c6299ecc51e3db/uncropped/2bb299-20130520-tornado4.jpg\",\"width\":600,\"height\":438},{\"url\":\"https://img.apmcdn.org/5cedd197b6d11e9ab1ce4d5751c6299ecc51e3db/uncropped/2b05a9-20130520-tornado4.jpg\",\"width\":1000,\"height\":729}]},\"widescreen\":{\"slug\":\"widescreen\",\"instances\":[{\"url\":\"https://img.apmcdn.org/5cedd197b6d11e9ab1ce4d5751c6299ecc51e3db/widescreen/3fb3b7-20130520-tornado4.jpg\",\"width\":400,\"height\":225},{\"url\":\"https://img.apmcdn.org/5cedd197b6d11e9ab1ce4d5751c6299ecc51e3db/widescreen/b20ac3-20130520-tornado4.jpg\",\"width\":600,\"height\":337},{\"url\":\"https://img.apmcdn.org/5cedd197b6d11e9ab1ce4d5751c6299ecc51e3db/widescreen/3e3ee3-20130520-tornado4.jpg\",\"width\":1000,\"height\":562}]}},\"short_caption\":\"Oklahoma City tornado\",\"preferred_aspect_ratio_slug\":\"uncropped\"}},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tFallin also spoke with President Barack Obama, who declared a major disaster and ordered federal aid to supplement state and local recovery efforts.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\" \\n\\tMany land lines to stricken areas were down, and cellphone networks were congested. The storm was so massive that it will take time to establish communications between rescuers and state officials, the governor said.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tIn video of the storm, the dark funnel cloud could be seen marching slowly across the green landscape. As it churned through the community, the twister scattered shards of wood, awnings and glass all over the streets.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\" \\n\\tChris Calvert saw the menacing tornado from about a mile away.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\" \\n\\t\\\"I was close enough to hear it,\\\" he said. \\\"It was just a low roar, and you could see the debris, like pieces of shingles and insulation and stuff like that, rotating around it.\\\"\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tEven though his subdivision is a mile from the tornado's path, it was still covered with debris. He found a picture of a small girl on Santa Claus' lap in his yard.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tVolunteers and first responders raced to search the debris for survivors.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tAt Plaza Towers Elementary School, the storm tore off the roof, knocked down walls and turned the playground into a mass of twisted plastic and metal.\\n \",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n\\tChildren from the school were among the dead, but several students were pulled alive from the rubble. Rescue workers passed the survivors down a human chain to the triage center in the parking lot.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tJames Rushing, who lives across the street from the school, heard reports of the approaching twister and ran to the school, where his 5-year-old foster son, Aiden, attends classes. Rushing believed he would be safer there.\\n \",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n\\t\\\"About two minutes after I got there, the school started coming apart,\\\" he said.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tThe students were sent into the restroom.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tA man with a megaphone stood near a Catholic church Monday evening and called out the names of surviving children. Parents waited nearby, hoping to hear their sons' and daughters' names.\\n \",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n\\tDon Denton hadn't heard from his two sons since the tornado hit the town, but the man who has endured six back surgeries and walks with a severe limp said he walked about two miles as he searched for them.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tAs reports of the storm came in, Denton's 16-year-old texted him, telling him to call.\\n \",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n\\t\\\"I was trying to call him, and I couldn't get through,\\\" Denton said. \",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tEventually, Denton said, his sons spotted him in the crowd. They were fine, but upset to hear that their grandparents' home was destroyed.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tAs dusk began to fall, heavy equipment was rolled up to the school, and emergency workers wearing yellow crawled among the ruins, searching for survivors.\\n \",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n\\tBecause the ground was muddy, bulldozers and front-end loaders were getting stuck. Crews used jackhammers and sledgehammers to tear away concrete, and chunks were being thrown to the side as the workers dug.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tDouglas Sherman drove two blocks from his home to help.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\t\\\"Just having those kids trapped in that school, that really turns the table on a lot of things,\\\" he said.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tA map provided by the National Weather Service showed that the storm began west of Newcastle and crossed the Canadian River into Oklahoma City's rural far southwestern side about 3 p.m. When it reached Moore, the twister cut a path through the center of town before lifting back into the sky at Lake Stanley Draper.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tOklahoma City Police Capt. Dexter Nelson said downed power lines and open gas lines posed a risk in the aftermath of the system.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tMonday's powerful tornado loosely followed the path of a killer twister that slammed the region in May 1999.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tThe weather service estimated that Monday's tornado was at least a half-mile wide. The 1999 storm had winds clocked at 300 mph.\\n \",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n\\tKelsey Angle, a weather service meteorologist in Kansas City, Mo., said it's unusual for two such powerful tornadoes to track roughly the same path.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tIt was the fourth tornado to hit Moore since 1998. A twister also struck in 2003.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tMonday's devastation in Oklahoma came almost exactly two years after an enormous twister ripped through the city of Joplin, Mo., killing 158 people and injuring hundreds more.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n \\n\\tThat May 22, 2011, tornado was the deadliest in the United States since modern tornado record keeping began in 1950, according to the National Oceanic and Atmospheric Administration. Before Joplin, the deadliest modern tornado was June 1953 in Flint, Mich., when 116 people died.\\n \",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n\",\"type\":\"text\"}]},{\"type\":\"blockquote\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"DEADLIEST US TORNADOES SINCE 1900\",\"type\":\"text\",\"marks\":[{\"type\":\"strong\"}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\nA list of the 10 deadliest tornadoes in the United States since 1900:\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"• 695 deaths. March 18, 1925, in Missouri, Illinois and Indiana.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\" \\n• 216 deaths. April 5, 1936, in Tupelo, Miss.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\" \\n• 203 deaths. April 6, 1936, in Gainesville, Ga.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\" \\n• 181 deaths. April 9, 1947, in Woodward, Okla.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\" \\n• 158 deaths. May 22, 2011, in Joplin, Mo.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\" \\n• 143 deaths. April 24, 1908, in Amite, La., and Purvis, Miss.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\" \\n• 116 deaths. June 8, 1953, in Flint, Mich.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\" \\n• 114 deaths. May 11, 1953 in Waco, Texas.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\" \\n• 114 deaths. May 18, 1902 in Goliad, Texas.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\" \\n• 103 deaths. March 23, 1913, in Omaha, Neb.\",\"type\":\"text\"},{\"type\":\"hard_break\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Source: National Oceanic and Atmospheric Administration \",\"type\":\"text\",\"marks\":[{\"type\":\"em\"}]},{\"text\":\"\\n\",\"type\":\"text\"}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\n\",\"type\":\"text\"},{\"text\":\"\\nAssociated Press writers Sean Murphy, Nomaan Merchant and Sue Ogrocki contributed to this report. \\n\",\"type\":\"text\",\"marks\":[{\"type\":\"em\"}]}]},{\"type\":\"apm_gallery\",\"attrs\":{\"title\":\"Gallery\"},\"content\":[{\"type\":\"apm_image\",\"attrs\":{\"id\":\"0a7552f8f92f81770ec9ae8e363a9fc6576dbd97\",\"url\":\"https://img.publicradio.org/images/20130520-oklahoma-tornado2.jpg\",\"type\":\"apmImage\",\"float\":\"right\",\"width\":\"half\",\"credit\":\"AP Photo/Sue Ogrocki\",\"credit_url\":\"\",\"long_caption\":\"A woman carries her child through a field near the collapsed Plaza Towers Elementary School in Moore, Okla., Monday, May 20, 2013. A tornado as much as a mile (1.6 kilometers) wide with winds up to 200 mph roared through the Oklahoma City suburbs Monday, flattening entire neighborhoods, setting buildings on fire and landing a direct blow on an elementary school.\",\"aspect_ratios\":{\"normal\":{\"slug\":\"normal\",\"instances\":[{\"url\":\"https://img.apmcdn.org/0a7552f8f92f81770ec9ae8e363a9fc6576dbd97/normal/63dbcb-20130520-oklahoma-tornado2.jpg\",\"width\":400,\"height\":301},{\"url\":\"https://img.apmcdn.org/0a7552f8f92f81770ec9ae8e363a9fc6576dbd97/normal/c6df49-20130520-oklahoma-tornado2.jpg\",\"width\":600,\"height\":451},{\"url\":\"https://img.apmcdn.org/0a7552f8f92f81770ec9ae8e363a9fc6576dbd97/normal/d32c57-20130520-oklahoma-tornado2.jpg\",\"width\":1000,\"height\":752}]},\"square\":{\"slug\":\"square\",\"instances\":[{\"url\":\"https://img.apmcdn.org/0a7552f8f92f81770ec9ae8e363a9fc6576dbd97/squar